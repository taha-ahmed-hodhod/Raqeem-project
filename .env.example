# =============================================================================
# Raqeem / رقيم — Environment Variables Template
# Copy to .env.local and fill in real values. NEVER commit .env.local or secrets.
# =============================================================================

# --- Public App Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Client & Server) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# --- Supabase (Server-Only — NEVER expose to browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Admin Access Control (Single Admin Allowlist) ---
ADMIN_ALLOWED_EMAIL=admin@example.com

# --- Web Push / VAPID (M5 Notifications) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# --- Resend Email Alerts (M5 Notifications — Server-Only) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@example.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com
